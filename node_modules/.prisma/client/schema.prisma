datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LabStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CostRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SCENARIO
  INTERVIEW
  CLI_OUTPUT
}

enum CleanupStatus {
  PENDING
  CLEANED
  VERIFIED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role      @default(USER)
  targetDate       DateTime?
  dailyGoalMinutes Int       @default(45)
  streakDays       Int       @default(0)
  lastActiveDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  topicProgress     UserTopicProgress[]
  labProgress       UserLabProgress[]
  quizAttempts      QuizAttempt[]
  userAnswers       UserAnswer[]
  interviewSessions InterviewSession[]
  bookmarks         Bookmark[]
  revisionSchedules RevisionSchedule[]
  activities        LearningActivity[]
  safetySettings    BudgetSafetySetting?
  cleanupRecords    LabCleanupRecord[]

  @@map("users")
}

model LearningModule {
  id           String   @id @default(uuid())
  moduleNumber Int      @unique
  title        String
  slug         String   @unique
  description  String   @db.Text
  icon         String   @default("cloud")
  level        String   @default("Beginner")
  createdAt    DateTime @default(now())

  topics Topic[]

  @@map("learning_modules")
}

model Topic {
  id               String   @id @default(uuid())
  moduleId         String
  topicNumber      Int
  title            String
  slug             String   @unique
  summary          String   @db.Text
  difficulty       String   @default("Beginner")
  estimatedMinutes Int      @default(30)
  keyTakeaway      String   @db.Text
  createdAt        DateTime @default(now())

  module            LearningModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  notes             TopicNote?
  labs              Lab[]
  questions         Question[]
  userProgress      UserTopicProgress[]
  quizAttempts      QuizAttempt[]
  interviewSessions InterviewSession[]
  revisionSchedules RevisionSchedule[]

  @@index([moduleId])
  @@map("topics")
}

model TopicNote {
  id                   String   @id @default(uuid())
  topicId              String   @unique
  simpleExplanation    String   @db.LongText
  coreConceptsJson     String   @db.LongText // JSON array of concepts
  internalsExplanation String   @db.LongText
  architectureSvg      String?  @db.LongText
  cliExamplesJson      String   @db.LongText // JSON array of CLI commands with explanations
  bestPracticesJson    String   @db.LongText // JSON array
  securityNotes        String   @db.LongText
  costImplications     String   @db.LongText
  commonMistakesJson   String   @db.LongText // JSON array
  quickRevisionJson    String   @db.LongText // JSON array
  updatedAt            DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_notes")
}

model Lab {
  id                     String        @id @default(uuid())
  topicId                String
  title                  String
  level                  String        @default("Beginner")
  estimatedMinutes       Int           @default(25)
  freeTierEligible       Boolean       @default(true)
  costRiskLevel          CostRiskLevel @default(LOW)
  paidAlternativeWarning String?       @db.Text
  prerequisites          String        @db.Text
  requiredPermissions    String        @db.Text
  cleanupGuide           String        @db.LongText
  safeSimulationScript   String?       @db.LongText
  createdAt              DateTime      @default(now())

  topic          Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  steps          LabStep[]
  userProgress   UserLabProgress[]
  cleanupRecords LabCleanupRecord[]

  @@index([topicId])
  @@map("labs")
}

model LabStep {
  id                 String  @id @default(uuid())
  labId              String
  stepNumber         Int
  title              String
  description        String  @db.Text
  consoleInstruction String  @db.LongText
  cliCommand         String? @db.Text
  expectedOutput     String? @db.Text
  verificationTip    String  @db.Text
  troubleshooting    String  @db.Text

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@map("lab_steps")
}

model UserTopicProgress {
  id               String      @id @default(uuid())
  userId           String
  topicId          String
  status           TopicStatus @default(NOT_STARTED)
  notesRead        Boolean     @default(false)
  labCompleted     Boolean     @default(false)
  quizPassed       Boolean     @default(false)
  timeSpentSeconds Int         @default(0)
  completedAt      DateTime?
  updatedAt        DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@map("user_topic_progress")
}

model UserLabProgress {
  id                 String    @id @default(uuid())
  userId             String
  labId              String
  status             LabStatus @default(NOT_STARTED)
  completedStepsJson String    @default("[]") @db.VarChar(2000) // JSON array of step numbers completed
  isCleanedUp        Boolean   @default(false)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
  @@map("user_lab_progress")
}

model Question {
  id                  String       @id @default(uuid())
  topicId             String
  type                QuestionType @default(MCQ)
  difficulty          String       @default("Beginner")
  title               String
  prompt              String       @db.LongText
  explanation         String       @db.LongText
  hintsJson           String?      @db.LongText // JSON array of step-by-step hints
  rubricJson          String?      @db.LongText // For mock interviews / scenarios
  recommendedSolution String?      @db.LongText
  tagsJson            String?      @db.Text // JSON array of tags
  createdAt           DateTime     @default(now())

  topic       Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options     QuestionOption[]
  userAnswers UserAnswer[]

  @@index([topicId])
  @@index([type])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  optionKey  String // 'A', 'B', 'C', 'D'
  optionText String  @db.Text
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model QuizAttempt {
  id               String   @id @default(uuid())
  userId           String
  topicId          String
  score            Float
  totalQuestions   Int
  passed           Boolean
  timeSpentSeconds Int      @default(0)
  createdAt        DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@index([userId])
  @@index([topicId])
  @@map("quiz_attempts")
}

model UserAnswer {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  quizAttemptId  String?
  selectedOption String?
  submittedText  String?  @db.LongText
  isCorrect      Boolean?
  scoreGiven     Float?
  feedback       String?  @db.LongText
  createdAt      DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAttempt QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
  @@index([quizAttemptId])
  @@map("user_answers")
}

model InterviewSession {
  id              String    @id @default(uuid())
  userId          String
  topicId         String
  totalQuestions  Int       @default(5)
  overallScore    Float     @default(0)
  feedbackSummary String?   @db.LongText
  status          String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@map("interview_sessions")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  itemType  String // TOPIC, NOTE, LAB, QUESTION, SCENARIO
  itemId    String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId])
  @@map("bookmarks")
}

model RevisionSchedule {
  id             String   @id @default(uuid())
  userId         String
  topicId        String
  nextReviewDate DateTime
  intervalDays   Int      @default(1)
  repetitions    Int      @default(0)
  easeFactor     Float    @default(2.5)
  status         String   @default("DUE") // DUE, COMPLETED, SNOOZED
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([nextReviewDate])
  @@map("revision_schedules")
}

model LearningActivity {
  id           String   @id @default(uuid())
  userId       String
  actionType   String // READ_NOTE, COMPLETED_LAB, PASSED_QUIZ, SOLVED_SCENARIO, MOCK_INTERVIEW
  metadataJson String?  @db.Text
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("learning_activities")
}

model BudgetSafetySetting {
  id                    String   @id @default(uuid())
  userId                String   @unique
  monthlyBudgetLimit    Float    @default(5.0)
  alertEmail            String?
  currentEstimatedSpend Float    @default(0.0)
  isFreeTierOnlyMode    Boolean  @default(true)
  lastChecked           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_safety_settings")
}

model LabCleanupRecord {
  id           String        @id @default(uuid())
  userId       String
  labId        String
  resourceName String
  serviceName  String
  region       String        @default("us-east-1")
  status       CleanupStatus @default(PENDING)
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([labId])
  @@map("lab_cleanup_records")
}
